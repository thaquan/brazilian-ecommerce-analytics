	column 'Delivery Status' = ```
			SWITCH(
				TRUE(),
				ISBLANK(Fact_Orders[is_late_delivery]), "Unknown",
				Fact_Orders[is_late_delivery] = 1, "Late",
				"On Time"
			)
			```
		lineageTag: 8f05f3c7-2fe6-4ada-a316-2012dfafd2f7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Delay Bucket Sort' = ```
			VAR DelayDays = Fact_Orders[delivery_delay_days]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(DelayDays), 6,
					DelayDays <= 0, 1,
					DelayDays <= 3, 2,
					DelayDays <= 7, 3,
					DelayDays <= 14, 4,
					5
				)
			```
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: aff148d4-4642-4229-b909-25a259c7d45f
		summarizeBy: none

	column 'Delay Bucket' = ```
			VAR DelayDays = Fact_Orders[delivery_delay_days]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(DelayDays), "Unknown",
					DelayDays <= 0, "On Time",
					DelayDays <= 3, "1-3 Days Late",
					DelayDays <= 7, "4-7 Days Late",
					DelayDays <= 14, "8-14 Days Late",
					"15+ Days Late"
				)
			```
		dataType: string
		lineageTag: e49b7f5f-ab8e-44ab-a275-929aaf86de03
		summarizeBy: none
		sortByColumn: 'Delay Bucket Sort'

