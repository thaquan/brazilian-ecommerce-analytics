{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.157.json",
  "name": "OlistEditorial-a831d9f2.json",
  "dataColors": [
    "#0072B2",
    "#E69F00",
    "#009E73",
    "#CC79A7",
    "#56B4E9",
    "#D55E00",
    "#8F95D3",
    "#7A9E7E"
  ],
  "foreground": "#172B4D",
  "foregroundNeutralSecondary": "#667085",
  "foregroundNeutralTertiary": "#D9E2EC",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F7FA",
  "backgroundNeutral": "#D9E2EC",
  "tableAccent": "#0072B2",
  "good": "#2E7D32",
  "neutral": "#B26A00",
  "bad": "#C62828",
  "maximum": "#0072B2",
  "center": "#E69F00",
  "minimum": "#D8EAF5",
  "null": "#B8C2CC",
  "textClasses": {
    "callout": {
      "fontSize": 20,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#17324D"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#172B4D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9E2EC"
              }
            },
            "width": 1,
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#17324D"
              }
            },
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "bold": true,
            "fontSize": 20,
            "fontColor": {
              "solid": {
                "color": "#17324D"
              }
            }
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": true,
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#667085"
              }
            }
          }
        ],
        "cardCalloutArea": [
          {
            "paddingUniform": 4,
            "rectangleRoundedCurve": 6,
            "backgroundFillColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E8EDF3"
              }
            },
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#0072B2"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E8EDF3"
              }
            }
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#0072B2"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#009E73"
              }
            }
          }
        ]
      }
    },
    "hundredPercentStackedBarChart": {
      "*": {
        "labels": [
          {
            "show": true
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    }
  }
}